{
  "name": "dsh-pocket-console",
  "version": "0.8.1",
  "description": "Don't hand over the whole machine, just the decision blocking it: unattended DeepSeek Harness approvals and ask_user_question prompts reach your phone as Feishu cards, desktop first, outbound only.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./providers/feishu.js": "./providers/feishu.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "results.js",
    "identity.js",
    "workspaces.js",
    "notice-store.js",
    "routes.js",
    "mirror.js",
    "escalation.js",
    "messages.js",
    "budget.js",
    "providers/feishu.js",
    "providers/README.md",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "docs/README.md",
    "docs/configuration.md",
    "docs/troubleshooting.md",
    "docs/development.md",
    "docs/releasing.md",
    "docs/zh-CN/",
    "docs/decisions/",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "picsky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picsky/dsh-pocket-console.git"
  },
  "homepage": "https://github.com/picsky/dsh-pocket-console#readme",
  "bugs": {
    "url": "https://github.com/picsky/dsh-pocket-console/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --import ./tests/fixtures/hooks.mjs --test \"tests/**/*.test.mjs\"",
    "prepack": "node scripts/verify-pack.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "e2e": "node scripts/e2e-profile.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "harness",
    "cordis",
    "cordis-plugin",
    "plugin",
    "bundle",
    "approval",
    "approvals",
    "permission",
    "permissions",
    "human-in-the-loop",
    "hitl",
    "ask-user-question",
    "remote-approval",
    "mobile-approval",
    "phone-approval",
    "unattended",
    "desktop-first",
    "no-tunnel",
    "outbound-only",
    "least-privilege",
    "feishu",
    "lark",
    "feishu-bot",
    "interactive-card",
    "chatops",
    "notification",
    "mobile",
    "qr-code"
  ],
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "qrcode": "^1.5.4"
  },
  "bundleDependencies": [
    "@larksuiteoapi/node-sdk",
    "qrcode"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/schemastery": "*",
    "zod": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
